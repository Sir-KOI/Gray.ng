generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url = "file:C:/Users/OSE/gray.ng/prisma/dev.db"
}

model User {
  id        String   @id @default(cuid())
  name      String?
  email     String?  @unique
  phone     String?  @unique
  
  password  String?
  balance   Float    @default(0)
  createdAt DateTime @default(now())
}
